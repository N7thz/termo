{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termo",
  "version": "0.1.0",
  "identifier": "dev.termo.app",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Termo",
        "width": 1100,
        "height": 700,
        "minWidth": 480,
        "minHeight": 300,
        "backgroundColor": "#0f1117",
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/conpty.dll": "conpty.dll",
      "resources/OpenConsole.exe": "OpenConsole.exe"
    }
  }
}
