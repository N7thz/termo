{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termo",
  "version": "0.2.1",
  "identifier": "dev.termo.app",
  "build": {
    "beforeDevCommand": "bun run build:cli && bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:cli && bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Termo",
        "width": 1100,
        "height": 700,
        "minWidth": 480,
        "minHeight": 300,
        "backgroundColor": "#0f1117",
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "N7thz",
    "copyright": "Copyright (c) 2026 N7thz. Licença MIT.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/N7thz/termo",
    "category": "DeveloperTool",
    "shortDescription": "Terminal moderno com blocos, painéis e atalho para o Claude Code",
    "longDescription": "Terminal para Windows com comandos em blocos, painéis divididos, navegador embutido, perfis de shell (PowerShell, cmd, WSL) e integração com o Claude Code.",
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installMode": "currentUser"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/conpty.dll": "conpty.dll",
      "resources/OpenConsole.exe": "OpenConsole.exe",
      "../cli/target/release/termo.exe": "bin/termo.exe"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3NjA2MDhCM0QzMzkwREMKUldUY2tETTlpMkJnRjRJeEh5a2dEUGx3bzVRWE43SUJrOVBGWWtxRWV5akx1cER5alR1aDlwejIK",
      "endpoints": ["https://github.com/N7thz/termo/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
