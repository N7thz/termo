{
  "name": "termo",
  "version": "0.2.0",
  "description": "Terminal moderno inspirado no Warp, com ligaduras, imagens e atalho para o Claude Code",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:claude": "tauri dev -- -- --claude",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "build:cli": "cargo build --release --manifest-path cli/Cargo.toml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test src && bun run build:cli && cargo test --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path cli/Cargo.toml",
    "test:web": "bun test src",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo clippy --manifest-path cli/Cargo.toml -- -D warnings",
    "check": "bun run typecheck && bun run lint && bun run lint:rust && bun run test",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
